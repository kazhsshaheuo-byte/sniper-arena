-- ===== МОМЕНТАЛЬНЫЙ ГЛАВНЫЙ ЦИКЛ (БЕЗ ОТСТАВАНИЙ) =====
RunService.RenderStepped:Connect(function()
    -- Рендеринг FOV независимо от открытого меню
    FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    -- ESP БЛОК
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if Settings.ESP_Box and char:FindFirstChild("Head") then
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
        end
    end
    
    -- ЛОГИКА AIMBOT И TRIGGERBOT (МОМЕНТАЛЬНАЯ ДОВОДКА)
    if isKeyPressed then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local deltaX = screenPos.X - mousePos.X
                local deltaY = screenPos.Y - mousePos.Y
                local dist = Vector2.new(deltaX, deltaY).Magnitude
                
                -- Логика авто-выстрела (Triggerbot)
                if Settings.TriggerBot and canShoot and dist <= Settings.TriggerPrecision then
                    Shoot()
                end
                
                -- МОМЕНТАЛЬНЫЙ АИМБОТ: Привязка CFrame намертво + синхронизация мыши
                if Settings.Aimbot then
                    -- 1. Жестко разворачиваем камеру точно на голову (убирает любые отставания при прыжках/беге)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                    
                    -- 2. Дополнительно мгновенно доводим курсор мыши в ту же точку
                    if mousemoverel then
                        pcall(function()
                            mousemoverel(deltaX, deltaY) -- Без smooth, перенос 1 к 1
                        end)
                    end
                end
            end
        end
    end
end)
