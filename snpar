-- ===== ИДЕАЛЬНЫЙ ЦИКЛ ОБРАБОТКИ (RenderStepped) =====
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            
            if head and head:IsA("BasePart") then
                -- Стабильный Force-апдейт хитбоксов
                if Settings.HeadSize > 1 then
                    head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                    head.Transparency = 0.7 
                    head.CanCollide = false
                    head.Massless = true
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
                
                -- Рендер ESP (Неоновый стиль)
                if Settings.ESP_Box then
                    local highlight = char:FindFirstChild("PoloESP")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "PoloESP"
                        highlight.Parent = char
                    end
                    highlight.FillColor = Color3.fromRGB(0, 255, 204)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    local h = char:FindFirstChild("PoloESP")
                    if h then h:Destroy() end
                end
            end
        end
    end
    
    -- МАТЕМАТИЧЕСКИЙ ВЫСОКОТОЧНЫЙ ТРИГГЕРБОТ
    if Settings.TriggerBot then
        local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local char = player.Character
                local realHeadCenter = char.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
                
                local rayOrigin = ray.Origin
                local rayDirection = ray.Direction.Unit
                local playerVector = realHeadCenter - rayOrigin
                local dotProduct = playerVector:Dot(rayDirection)
                
                if dotProduct > 0 then
                    local closestPointOnRay = rayOrigin + (rayDirection * dotProduct)
                    local distanceToTrueHead = (realHeadCenter - closestPointOnRay).Magnitude
                    
                    if distanceToTrueHead <= 1.4 then -- Захват строго оригинальных 1.4 студа реальной головы
                        if IsPlayerVisible(char) then
                            InstantShoot()
                            break
                        end
                    end
                end
            end
        end
    end
    
    -- БЕЗУПРЕЧНЫЙ ФИКСИРОВАННЫЙ АИМБОТ
    if isKeyPressed and Settings.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local exactHeadPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
            
            -- Мертвая хватка камеры на реальном центре без конфликтов с мышью
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, exactHeadPos)
        end
    end
end)
