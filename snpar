-- ===== ПРОВЕРКА АДМИНОВ =====
local function CheckAdmins()
    if not Settings.AdminCheck then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            for _, adminId in pairs(AdminIDs) do
                if player.UserId == adminId and Settings.AdminLeave then
                    pcall(function()
                        game:GetService("StarterGui"):SetCore("SendNotification", {
                            Title = "⚠️ ADMIN DETECTED",
                            Text = player.Name .. " is an admin! Leaving...",
                            Duration = 3
                        })
                    end)
                    task.wait(1)
                    game:GetService("TeleportService"):Teleport(game.PlaceId)
                    return
                end
            end
        end
    end
end

-- ===== ФУНКЦИИ =====
local function GetHeadPosition(char)
    local head = char:FindFirstChild("Head")
    return head and head.Position or nil
end

local function IsPlayerVisible(char)
    if not char or not char:FindFirstChild("Head") then return false end
    local head = char.Head
    local origin = Camera.CFrame.Position
    local dir = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(char)
end

-- ===== ИДЕАЛЬНЫЙ ТРИГГЕР =====
local function IsPerfectAimingAtHead(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    local humanoid = target.Character:FindFirstChild("Humanoid")
    if not head or not humanoid or humanoid.Health <= 0 then return false end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
    if dist > Settings.TriggerPrecision then return false end
    
    local camPos = Camera.CFrame.Position
    local camDir = Camera.CFrame.LookVector
    local dirToHead = (head.Position - camPos).Unit
    local angle = math.deg(math.acos(math.clamp(camDir:Dot(dirToHead), -1, 1)))
    
    if angle > Settings.TriggerAngle then return false end
    return true
end

local function GetTriggerTarget()
    local best, bestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if Settings.ESP_TeamCheck and player.Team == LocalPlayer.Team then continue end
            if Settings.AimbotWallCheck and not IsPlayerVisible(player.Character) then continue end
            local headPos = GetHeadPosition(player.Character)
            if headPos then
                local pos, on = Camera:WorldToViewportPoint(headPos)
                if on and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < bestDist and dist < Settings.AimbotFOV then
                        bestDist, best = dist, player
                    end
                end
            end
        end
    end
    return best
end

local function GetClosestPlayer()
    local closest, closestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Head") then
        local headPos = GetHeadPosition(currentTarget.Character)
        if headPos then
            local pos, on = Camera:WorldToViewportPoint(headPos)
            if on and pos.Z > 0 then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < Settings.AimbotFOV then
                    if Settings.AimbotWallCheck then
                        if IsPlayerVisible(currentTarget.Character) then 
                            return currentTarget
                        else 
                            currentTarget = nil 
                        end
                    else
                        return currentTarget
                    end
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if Settings.ESP_TeamCheck and player.Team == LocalPlayer.Team then continue end
            if Settings.AimbotWallCheck and not IsPlayerVisible(player.Character) then continue end
            local headPos = GetHeadPosition(player.Character)
            if headPos then
                local pos, on = Camera:WorldToViewportPoint(headPos)
                if on and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist and dist < Settings.AimbotFOV then
                        closestDist, closest = dist, player
                    end
                end
            end
        end
    end
    if closest then currentTarget = closest end
    return closest
end

local function InstantAim(target)
    if not target or not target.Character then return end
    if Settings.AimbotWallCheck and not IsPlayerVisible(target.Character) then return end
    local headPos = GetHeadPosition(target.Character)
    if not headPos then return end
    
    local newCF = CFrame.lookAt(Camera.CFrame.Position, headPos)
    if Settings.AimbotSmooth <= 1 then
        Camera.CFrame = newCF
    else
        Camera.CFrame = Camera.CFrame:Lerp(newCF, 1 / Settings.AimbotSmooth)
    end
    
    local screenPos, on = Camera:WorldToViewportPoint(headPos)
    if on then
        local mousePos = UserInputService:GetMouseLocation()
        local dx, dy = screenPos.X - mousePos.X, screenPos.Y - mousePos.Y
        if math.abs(dx) > 0.5 or math.abs(dy) > 0.5 then
            pcall(function()
                if typeof(mousemoverel) == "function" then
                    if Settings.AimbotSmooth <= 1 then
                        mousemoverel(dx, dy)
                    else
                        mousemoverel(dx / Settings.AimbotSmooth, dy / Settings.AimbotSmooth)
                    end
                end
            end)
        end
    end
end

local function PerfectShot()
    if not canShoot then return end
    local now = tick()
    if now - lastShootTime < shootCooldown then return end
    lastShootTime = now
    canShoot = false
    
    task.spawn(function()
        pcall(function()
            if mouse1click then
                mouse1click()
            elseif mouse1press and mouse1release then
                mouse1press()
                task.wait()
                mouse1release()
            end
        end)
        if Settings.TriggerDelay > 0 then
            task.wait(Settings.TriggerDelay)
        end
        canShoot = true
    end)
end

local function ApplyWeaponMods()
    pcall(function()
        if not LocalPlayer.Character then return end
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    local name = child.Name:lower()
                    if Settings.NoRecoil and (name:find("recoil") or name:find("kick")) then child.Value = 0 end
                    if Settings.NoSpread and (name:find("spread") or name:find("accuracy")) then child.Value = 0 end
                    if Settings.FastReload and name:find("reload") then child.Value = 0.01 end
                end
            end
        end
    end)
end

-- ===== ESP DRAWING FUNCTIONS =====
local function DrawSkeleton(char)
    if not char then return end
    local function getPart(n) return char:FindFirstChild(n) end
    local function drawLine(p1, p2, c)
        if not p1 or not p2 then return end
        local a, b = Camera:WorldToViewportPoint(p1.Position), Camera:WorldToViewportPoint(p2.Position)
        if a.Z > 0 and b.Z > 0 then
            local line = Drawing.new("Line")
            line.Visible = true
            line.From, line.To = Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y)
            line.Color, line.Thickness = c or Color3.fromRGB(150,80,255), 2
            table.insert(Drawings, line)
        end
    end
    local h = getPart("Head")
    local u = getPart("UpperTorso") or getPart("Torso")
    local l = getPart("LowerTorso")
    local la, ra = getPart("LeftUpperArm") or getPart("Left Arm"), getPart("RightUpperArm") or getPart("Right Arm")
    local ll, rl = getPart("LeftUpperLeg") or getPart("Left Leg"), getPart("RightUpperLeg") or getPart("Right Leg")
    local c = Color3.fromRGB(160, 90, 255)
    if u and h then drawLine(u, h, c) end
    if u and l then drawLine(u, l, c) end
    if u and la then drawLine(u, la, c) end
    if u and ra then drawLine(u, ra, c) end
    if l and ll then drawLine(l, ll, c) end
    if l and rl then drawLine(l, rl, c) end
end

local function DrawDistance(char)
    if not char or not char:FindFirstChild("Head") then return end
    local head = char.Head
    local dist = (Camera.CFrame.Position - head.Position).Magnitude
    local pos, on = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,2.5,0))
    if on and pos.Z > 0 then
        local t = Drawing.new("Text")
        t.Visible = true
        t.Position = Vector2.new(pos.X, pos.Y)
        t.Text = math.round(dist) .. "m"
        t.Color = Color3.fromRGB(255,255,255)
        t.Size, t.Center, t.Outline, t.OutlineColor = 14, true, true, Color3.fromRGB(0,0,0)
        table.insert(Drawings, t)
    end
end

local function DrawLineToPlayer(char)
    if not char or not char:FindFirstChild("Head") then return end
    local pos, on = Camera:WorldToViewportPoint(char.Head.Position)
    if on and pos.Z > 0 then
        local line = Drawing.new("Line")
        line.Visible = true
        line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        line.To = Vector2.new(pos.X, pos.Y)
        line.Color, line.Thickness = Color3.fromRGB(140,70,240), 1
        table.insert(Drawings, line)
    end
end

local function DrawFOV()
    local c = Drawing.new("Circle")
    c.Visible = true
    c.Radius, c.Thickness, c.Color, c.Filled = Settings.AimbotFOV, 1.5, Color3.fromRGB(180,140,255), false
    c.Position = UserInputService:GetMouseLocation()
    table.insert(Drawings, c)
end

