local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local Settings = {
    Aimbot = true,
    AimbotSmooth = 0.1,
    AimbotFOV = 200,
    ESP_Box = true,
    VisCheck = true -- Wall check enabled
}

local isKeyPressed = false
local Drawings = {}

-- Key bindings for E key
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E then
        isKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E then
        isKeyPressed = false
    end
end)

-- Function to check if player is visible (wall check)
local function IsPlayerVisible(character)
    if not character or not character:FindFirstChild("Head") then
        return false
    end
    
    local head = character.Head
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    
    -- Check if head is visible
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
    
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    
    -- If no hit, or hit is the head itself, it's visible
    if not raycastResult then
        return true
    end
    
    -- Check if the hit is part of the target's head
    local hitPart = raycastResult.Instance
    if hitPart and hitPart:IsDescendantOf(character) then
        return true
    end
    
    return false
end

-- Function to get closest player to crosshair
local function GetClosestPlayer()
    local closest = nil
    local closestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local character = player.Character
            local head = character.Head
            
            -- Check visibility first if wall check is enabled
            if Settings.VisCheck and not IsPlayerVisible(character) then
                continue
            end
            
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < closestDist and dist < Settings.AimbotFOV then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

-- Main loop
RunService.RenderStepped:Connect(function()
    -- Clear old drawings
    for _, drawing in pairs(Drawings) do
        drawing:Remove()
    end
    Drawings = {}
    
    -- Draw FOV circle
    local fovCircle = Drawing.new("Circle")
    fovCircle.Visible = true
    fovCircle.Radius = Settings.AimbotFOV
    fovCircle.Thickness = 2
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Filled = false
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, fovCircle)
    
    -- ESP Box
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local character = player.Character
            
            -- Only show ESP if visible (optional, but makes sense with wall check)
            if Settings.VisCheck and not IsPlayerVisible(character) then
                -- Remove ESP if not visible
                local highlight = character:FindFirstChild("PoloESP")
                if highlight then
                    highlight:Destroy()
                end
                continue
            end
            
            -- ESP Box
            if Settings.ESP_Box then
                local highlight = character:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight", character)
                    highlight.Name = "PoloESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                end
            end
        end
    end
    
    -- Aimbot with wall check
    if Settings.Aimbot and isKeyPressed then
        local target = GetClosestPlayer()
        if target then
            local headPos = target.Character.Head.Position
            local screenPos = Camera:WorldToViewportPoint(headPos)
            local mousePos = UserInputService:GetMouseLocation()
            
            local deltaX = screenPos.X - mousePos.X
            local deltaY = screenPos.Y - mousePos.Y
            
            if Settings.AimbotSmooth > 0 then
                mousemoverel(deltaX / (1/Settings.AimbotSmooth), deltaY / (1/Settings.AimbotSmooth))
            else
                mousemoverel(deltaX, deltaY)
            end
        end
    end
end)

