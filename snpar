-- ===== ОЧИСТКА ХИТБОКСОВ ПРИ СМЕРТИ =====
local function CleanupDeadPlayer(player)
    if player.Character then
        local head = player.Character:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            head.Size = Vector3.new(1.2, 1.2, 1.2)
            head.Transparency = 0
            head.CanCollide = true
            head.Massless = false
        end
        local esp = player.Character:FindFirstChild("PoloESP")
        if esp then esp:Destroy() end
    end
end

-- Отслеживание смерти игроков
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        if player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid.Died:Connect(function()
                    CleanupDeadPlayer(player)
                end)
            end
        end
        player.CharacterAdded:Connect(function(char)
            local humanoid = char:WaitForChild("Humanoid")
            humanoid.Died:Connect(function()
                CleanupDeadPlayer(player)
            end)
        end)
    end
end

Players.PlayerRemoving:Connect(function(player)
    CleanupDeadPlayer(player)
end)

local function UnloadScript()
    ScriptActive = false
    aimbotActive = false
    for _, connection in pairs(Connections) do
        if connection then connection:Disconnect() end
    end
    if FOVCircle then
        FOVCircle.Visible = false
        FOVCircle:Remove()
    end
    for _, player in pairs(Players:GetPlayers()) do
        CleanupDeadPlayer(player)
    end
    if ScreenGui then ScreenGui:Destroy() end
end

-- ===== ПЛАВНЫЙ АИМБОТ (ИСПРАВЛЕННЫЙ) =====
local function SmoothAim(targetPos, smoothness)
    if not aimbotActive then return end
    
    -- Получаем текущее направление камеры
    local currentCF = Camera.CFrame
    local targetDirection = (targetPos - currentCF.Position).Unit
    
    -- Создаем целевой CFrame
    local targetCF = CFrame.new(currentCF.Position, currentCF.Position + targetDirection)
    
    -- Применяем сглаживание (интерполяция сферическая)
    local alpha = math.clamp(1 / smoothness, 0.05, 0.5)
    
    -- Плавная интерполяция
    Camera.CFrame = currentCF:Lerp(targetCF, alpha)
end

-- Основной цикл рендера
RunService.RenderStepped:Connect(function(deltaTime)
    if not ScriptActive then return end 
    
    -- Обновление FOV круга
    if FOVCircle then
        FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    end
    
    -- Обработка игроков
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local humanoid = char:FindFirstChild("Humanoid")
            
            -- Проверяем, жив ли игрок
            if humanoid and humanoid.Health > 0 then
                if head and head:IsA("BasePart") then
                    if Settings.ExpandHeads and Settings.HeadSize > 1 then
                        head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                        head.Transparency = 0.7 
                        head.CanCollide = false
                        head.Massless = true
                    else
                        head.Size = Vector3.new(1.2, 1.2, 1.2)
                        head.Transparency = 0
                    end
                end
            else
                -- Очищаем мертвого игрока
                CleanupDeadPlayer(player)
            end
            
            -- ESP обработка
            if Settings.ESP_Box and humanoid and humanoid.Health > 0 then
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 255, 255)
                highlight.OutlineColor = Color3.fromRGB(200, 200, 205)
                highlight.FillTransparency = 0.6
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
        end
    end
    
    -- ТРИГГЕРБОТ (исправленный)
    if Settings.TriggerBot and isActivationKeyPressed and not triggerCooldown then
        local target = GetClosestPlayer()
        
        if target and target.Character then
            local humanoid = target.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local headPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
                local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
                
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    if dist < Settings.AimbotFOV * 0.8 then -- Немного уменьшаем радиус для триггера
                        triggerCooldown = true
                        pcall(function()
                            mouse1click()
                        end)
                        task.wait(0.05) -- Увеличиваем задержку для предотвращения спама
                        triggerCooldown = false
                    end
                end
            end
        end
    end
    
    -- ПЛАВНЫЙ АИМБОТ (ИСПРАВЛЕННЫЙ)
    if Settings.Aimbot and aimbotActive then
        local target = GetClosestPlayer()
        if target and target.Character then
            local humanoid = target.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local exactHeadPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
                
                -- Используем deltaTime для более стабильной интерполяции
                local dynamicSmooth = Settings.AimbotSmooth * (1 / math.max(deltaTime, 0.016))
                SmoothAim(exactHeadPos, dynamicSmooth)
            else
                aimbotActive = false -- Деактивируем аимбот если цель мертва
                LastTarget = nil
            end
        end
    end
end)
