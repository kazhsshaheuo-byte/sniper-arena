    local function CreateSlider(parent, text, setting, min, max, default)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, -10, 0, 54)
        frame.BackgroundColor3 = Color3.fromRGB(50, 25, 90)
        frame.BackgroundTransparency = 0.4
        frame.BorderSizePixel = 0
        frame.Parent = parent
        
        local frameCorner = Instance.new("UICorner")
        frameCorner.CornerRadius = UDim.new(0, 10)
        frameCorner.Parent = frame
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -24, 0, 24)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text .. ": " .. tostring(default)
        label.TextColor3 = Color3.fromRGB(235, 215, 255)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.Gotham
        label.Parent = frame
        
        local sliderContainer = Instance.new("Frame")
        sliderContainer.Size = UDim2.new(0.85, 0, 0, 8)
        sliderContainer.Position = UDim2.new(0.05, 0, 0, 32)
        sliderContainer.BackgroundColor3 = Color3.fromRGB(30, 15, 55)
        sliderContainer.BorderSizePixel = 0
        sliderContainer.Parent = frame
        
        local sliderCorner = Instance.new("UICorner")
        sliderCorner.CornerRadius = UDim.new(0, 4)
        sliderCorner.Parent = sliderContainer
        
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(160, 80, 255)
        fill.BorderSizePixel = 0
        fill.Parent = sliderContainer
        
        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 4)
        fillCorner.Parent = fill
        
        local handle = Instance.new("Frame")
        handle.Size = UDim2.new(0, 18, 0, 18)
        handle.Position = UDim2.new((default - min) / (max - min), -9, 0.5, -9)
        handle.BackgroundColor3 = Color3.fromRGB(200, 150, 255)
        handle.BorderSizePixel = 0
        handle.Parent = sliderContainer
        
        local handleCorner = Instance.new("UICorner")
        handleCorner.CornerRadius = UDim.new(0, 9)
        handleCorner.Parent = handle
        
        local handleGlow = Instance.new("Frame")
        handleGlow.Size = UDim2.new(1, 16, 1, 16)
        handleGlow.Position = UDim2.new(0, -8, 0, -8)
        handleGlow.BackgroundColor3 = Color3.fromRGB(160, 80, 255)
        handleGlow.BackgroundTransparency = 0.8
        handleGlow.BorderSizePixel = 0
        handleGlow.Parent = handle
        
        local handleGlowCorner = Instance.new("UICorner")
        handleGlowCorner.CornerRadius = UDim.new(0, 16)
        handleGlowCorner.Parent = handleGlow
        
        local dragging = false
        local value = default
        
        local function updateSlider(input)
            local pos = math.clamp((input.Position.X - sliderContainer.AbsolutePosition.X) / sliderContainer.AbsoluteSize.X, 0, 1)
            value = min + pos * (max - min)
            
            if setting == "TriggerDelay" then
                value = math.round(value * 1000) / 1000
            else
                value = math.round(value)
            end
            
            Settings[setting] = value
            fill:TweenSize(UDim2.new(pos, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true)
            handle:TweenPosition(UDim2.new(pos, -9, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true)
            label.Text = text .. ": " .. tostring(value)
        end
        
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateSlider(input)
            end
        end)
        
        sliderContainer.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateSlider(input)
            end
        end)
        
        handle.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        sliderContainer.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        handle.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input)
            end
        end)
        
        sliderContainer.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input)
            end
        end)
        
        return sliderContainer
    end
    
    -- ===== ВКЛАДКИ =====
    -- Aimbot
    CreateToggle(tabContents[1], "🎯 Aimbot", "Aimbot", Settings.Aimbot)
    CreateSlider(tabContents[1], "🎯 FOV", "AimbotFOV", 50, 500, Settings.AimbotFOV)
    CreateSlider(tabContents[1], "🎯 Smoothness", "AimbotSmooth", 1, 10, Settings
