-- ===== ИДЕАЛЬНЫЙ ТРИГГЕРБОТ (ТОЛЬКО ТОЧНЫЕ ВЫСТРЕЛЫ В ГОЛОВУ) =====
-- ВСТАВЬТЕ ЭТУ ФУНКЦИЮ В ОСНОВНОЙ СКРИПТ ВМЕСТО СТАРОГО ТРИГГЕРА

local function GetHeadWorldPosition(target)
    if not target or not target.Character then return nil end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return nil end
    
    -- Получаем точную позицию головы с учетом анимаций
    return head.Position
end

local function GetHeadScreenPosition(target)
    if not target or not target.Character then return nil, false end
    
    local headPos = GetHeadWorldPosition(target)
    if not headPos then return nil, false end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    return screenPos, onScreen
end

-- ===== ПРОВЕРКА ТОЧНОГО НАВЕДЕНИЯ С УЧЕТОМ ДИСТАНЦИИ =====
local function IsPerfectAimingAtHead(target)
    if not target or not target.Character then return false end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    local headPos = GetHeadWorldPosition(target)
    if not headPos then return false end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
    
    -- Динамическая точность в зависимости от расстояния
    local distance = (Camera.CFrame.Position - headPos).Magnitude
    local precision = Settings.TriggerPrecision
    
    -- На большом расстоянии точность выше (меньше погрешность)
    if distance > 200 then
        precision = precision * 0.6
    elseif distance > 100 then
        precision = precision * 0.8
    end
    
    -- Проверяем что прицел точно на голове
    if dist > precision then
        return false
    end
    
    -- Проверяем что игрок жив
    local humanoid = target.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end
    
    return true
end

-- ===== ПРОВЕРКА ВИДИМОСТИ С ТОЧНОСТЬЮ =====
local function IsHeadVisible(target)
    if not target or not target.Character then return false end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, target.Character}
    
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    
    if not raycastResult then
        return true
    end
    
    local hitPart = raycastResult.Instance
    if hitPart and hitPart:IsDescendantOf(target.Character) then
        return true
    end
    
    return false
end

-- ===== ИДЕАЛЬНЫЙ ТРИГГЕРБОТ =====
local function PerfectTriggerBot()
    if not Settings.TriggerBot or not canShoot then return end
    
    local target = GetTriggerTarget()
    if not target then return end
    
    -- Проверка 1: Видимость головы
    if not IsHeadVisible(target) then
        return
    end
    
    -- Проверка 2: Точное наведение на голову
    if not IsPerfectAimingAtHead(target) then
        return
    end
    
    -- Проверка 3: Жив ли игрок
    local humanoid = target.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return
    end
    
    -- Проверка 4: Есть ли у нас оружие
    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Проверка 5: Готово ли оружие к выстрелу
    local isReady = true
    for _, child in pairs(tool:GetDescendants()) do
        if child:IsA("NumberValue") and child.Name:lower():find("cooldown") then
            if child.Value > 0 then
                isReady = false
            end
        end
    end
    
    if not isReady then return end
    
    -- ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ - МГНОВЕННЫЙ ВЫСТРЕЛ
    InstantShoot()
end

