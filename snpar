-- ===== ГЛАВНЫЙ ЦИКЛ ОБРАБОТКИ БЕЗ ОШИБОК =====
RunService.RenderStepped:Connect(function()
    -- Рендеринг FOV независимо от открытого меню
    FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    -- ESP БЛОК
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if Settings.ESP_Box and char:FindFirstChild("Head") then
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
        end
    end
    
    -- ЛОГИКА AIMBOT И TRIGGERBOT
    if isKeyPressed then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local deltaX = screenPos.X - mousePos.X
                local deltaY = screenPos.Y - mousePos.Y
                local dist = Vector2.new(deltaX, deltaY).Magnitude
                
                -- Логика авто-выстрела (Triggerbot)
                if Settings.TriggerBot and canShoot and dist <= Settings.TriggerPrecision then
                    Shoot()
                end
                
                -- Логика плавного наведения (Aimbot)
                if Settings.Aimbot and dist > 0.5 then
                    local smooth = math.clamp(Settings.AimbotSmooth, 0.05, 1)
                    
                    -- Проверяем поддержку mousemoverel вашим инжектором
                    if mousemoverel then
                        pcall(function()
                            mousemoverel(deltaX * smooth, deltaY * smooth)
                        end)
                    else
                        -- Универсальный обходной путь (Camera CFrame CFrame), если мышь заблокирована
                        local targetCFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smooth)
                    end
                end
            end
        end
    end
end)
