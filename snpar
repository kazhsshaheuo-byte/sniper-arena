-- ===== НАСТРОЙКИ =====
local Settings = {
    Aimbot = true,
    AimbotFOV = 250, 
    AimbotKey = Enum.KeyCode.E, 
    AimbotSmooth = 8, -- Увеличено для большей плавности
    TriggerBot = true,
    ESP_Box = true,
    ShowFOV = true,
    ExpandHeads = false,
    HeadSize = 6,
}

local isActivationKeyPressed = false
local Connections = {} 
local triggerCooldown = false
local aimbotActive = false

-- ===== КРУГ FOV =====
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = Settings.ShowFOV
FOVCircle.Radius = Settings.AimbotFOV
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Filled = false
FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

-- Упрощенная проверка видимости (без Raycast для производительности)
local function IsPlayerVisible(char)
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    if not char:FindFirstChild("Head") then return false end
    
    local head = char.Head
    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
    
    return onScreen and screenPos.Z > 0
end

-- Получение ближайшего игрока с приоритетом предыдущей цели
local function GetClosestPlayer()
    local closest = nil
    local closestDist = Settings.AimbotFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Если была предыдущая цель, даем ей приоритет
    if LastTarget and LastTarget.Character and LastTarget.Character:FindFirstChild("HumanoidRootPart") then
        if IsPlayerVisible(LastTarget.Character) and (tick() - LastTargetTime) < 0.5 then
            local realHeadPos = LastTarget.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
            local pos, onScreen = Camera:WorldToViewportPoint(realHeadPos)
            
            if onScreen and pos.Z > 0 then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < Settings.AimbotFOV * 1.2 then -- Небольшой бонус для предыдущей цели
                    return LastTarget
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            if IsPlayerVisible(char) then
                local realHeadPos = char.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
                local pos, onScreen = Camera:WorldToViewportPoint(realHeadPos)
                
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    if closest then
        LastTarget = closest
        LastTargetTime = tick()
    end
    
    return closest
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Settings.AimbotKey then 
        isActivationKeyPressed = true
        aimbotActive = true
    end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then 
        isActivationKeyPressed = false
        aimbotActive = false
        LastTarget = nil
    end
end))

