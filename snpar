local currentActiveButton = nil
local function SwitchTab(tabName, button)
    if currentActiveButton == button then return end
    
    for name, page in pairs(Pages) do
        if page.Visible and name ~= tabName then
            TweenService:Create(page, TweenInfo.new(0.15), {GroupTransparency = 1}):Play()
            task.delay(0.15, function() page.Visible = false end)
        end
    end
    
    local newPage = Pages[tabName]
    newPage.Visible = true
    TweenService:Create(newPage, TweenInfo.new(0.2), {GroupTransparency = 0}):Play()

    if currentActiveButton then 
        TweenService:Create(currentActiveButton, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(25, 25, 28),
            TextColor3 = Color3.fromRGB(140, 140, 145)
        }):Play()
        currentActiveButton:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(45, 45, 50)
    end
    
    currentActiveButton = button
    TweenService:Create(button, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(40, 40, 45),
        TextColor3 = Color3.fromRGB(255, 255, 255)
    }):Play()
    button:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(255, 255, 255) -- Белый акцент активной вкладки
end

