local function ApplyWeaponMods()
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    local name = child.Name:lower()
                    
                    if Settings.NoRecoil and (name:find("recoil") or name:find("kick")) then
                        child.Value = 0
                    end
                    
                    if Settings.NoSpread and (name:find("spread") or name:find("accuracy")) then
                        child.Value = 0
                    end
                    
                    if Settings.FastReload and name:find("reload") then
                        child.Value = 0.01
                    end
                end
            end
        end
    end)
end

-- ===== ESP SKELETON =====
local function DrawSkeleton(character)
    if not character then return end
    
    local parts = {
        Head = "Head",
        UpperTorso = "UpperTorso",
        LowerTorso = "LowerTorso",
        LeftArm = "LeftArm",
        RightArm = "RightArm",
        LeftLeg = "LeftLeg",
        RightLeg = "RightLeg",
    }
    
    local function getPart(name)
        return character:FindFirstChild(name) or character:FindFirstChild(name:lower())
    end
    
    local function drawLine(part1, part2, color)
        if not part1 or not part2 then return end
        local pos1, vis1 = Camera:WorldToViewportPoint(part1.Position)
        local pos2, vis2 = Camera:WorldToViewportPoint(part2.Position)
        if vis1 and vis2 then
            local line = Drawing.new("Line")
            line.Visible = true
            line.From = Vector2.new(pos1.X, pos1.Y)
            line.To = Vector2.new(pos2.X, pos2.Y)
            line.Color = color or Color3.fromRGB(150, 80, 255)
            line.Thickness = 2
            table.insert(Drawings, line)
        end
    end
    
    local head = getPart("Head")
    local upper = getPart("UpperTorso") or getPart("Torso")
    local lower = getPart("LowerTorso")
    local lArm = getPart("LeftArm")
    local rArm = getPart("RightArm")
    local lLeg = getPart("LeftLeg")
    local rLeg = getPart("RightLeg")
    
    local color = Color3.fromRGB(150, 80, 255)
    
    if upper and head then drawLine(upper, head, color) end
    if upper and lower then drawLine(upper, lower, color) end
    if upper and lArm then drawLine(upper, lArm, color) end
    if upper and rArm then drawLine(upper, rArm, color) end
    if lower and lLeg then drawLine(lower, lLeg, color) end
    if lower and rLeg then drawLine(lower, rLeg, color) end
end

local function DrawDistance(character)
    if not character or not character:FindFirstChild("Head") then return end
    
    local head = character.Head
    local dist = (Camera.CFrame.Position - head.Position).Magnitude
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2, 0))
    
    if onScreen then
        local text = Drawing.new("Text")
        text.Visible = true
        text.Position = Vector2.new(pos.X, pos.Y)
        text.Text = math.round(dist) .. "m"
        text.Color = Color3.fromRGB(255, 255, 255)
        text.Size = 14
        text.Center = true
        text.Outline = true
        text.OutlineColor = Color3.fromRGB(0, 0, 0)
        table.insert(Drawings, text)
    end
end

local function DrawLineToPlayer(character)
    if not character or not character:FindFirstChild("Head") then return end
    
    local head = character.Head
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    
    if onScreen then
        local line = Drawing.new("Line")
        line.Visible = true
        line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        line.To = Vector2.new(pos.X, pos.Y)
        line.Color = Color3.fromRGB(150, 80, 255)
        line.Thickness = 1
        table.insert(Drawings, line)
    end
end

local function DrawFOV()
    local fovCircle = Drawing.new("Circle")
    fovCircle.Visible = true
    fovCircle.Radius = Settings.AimbotFOV
    fovCircle.Thickness = 2
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Filled = false
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, fovCircle)
end

