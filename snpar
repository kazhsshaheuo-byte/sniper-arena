-- Sniper Arena Script by wizzey (PERFECT AIM - НИКАКОГО ОТСТАВАНИЯ)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ===== НАСТРОЙКИ =====
local Settings = {
    Aimbot = true,
    AimbotFOV = 300,
    AimbotKey = Enum.KeyCode.E,
    AimbotSmooth = 1.2, -- ОЧЕНЬ БЫСТРО, НО ПЛАВНО
    AimbotWallCheck = true,
    
    TriggerBot = true,
    TriggerPrecision = 15,
    TriggerDelay = 0.05,
    
    ESP_Box = true,
}

-- ===== ПЕРЕМЕННЫЕ =====
local isAimbotKeyPressed = false
local Drawings = {}
local canShoot = true
local currentTarget = nil
local lastTarget = nil

-- ===== WALL CHECK =====
local function IsPlayerVisible(char)
    if not char or not char:FindFirstChild("Head") then return false end
    local head = char.Head
    local origin = Camera.CFrame.Position
    local dir = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(char)
end

local function GetHeadPosition(char)
    local head = char:FindFirstChild("Head")
    return head and head.Position or nil
end

-- ===== AIMBOT (ИДЕАЛЬНЫЙ - БЕЗ ОТСТАВАНИЯ) =====
local function GetClosestPlayer()
    local closest = nil
    local closestDist = Settings.AimbotFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Сначала проверяем прошлую цель
    if lastTarget and lastTarget.Character and lastTarget.Character:FindFirstChild("Head") then
        local headPos = GetHeadPosition(lastTarget.Character)
        if headPos then
            local pos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen and pos.Z > 0 then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < Settings.AimbotFOV then
                    if Settings.AimbotWallCheck then
                        if IsPlayerVisible(lastTarget.Character) then
                            return lastTarget
                        end
                    else
                        return lastTarget
                    end
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            
            if Settings.AimbotWallCheck and not IsPlayerVisible(char) then
                continue
            end
            
            local headPos = GetHeadPosition(char)
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    if closest then
        lastTarget = closest
    end
    
    return closest
end

-- ===== TRIGGERBOT =====
local function IsAimingAtHead(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    if not IsPlayerVisible(target.Character) then
        return false
    end
    
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
    
    return dist < Settings.TriggerPrecision
end

local function Shoot()
    if not canShoot then return end
    canShoot = false
    pcall(function() mouse1click() end)
    task.wait(Settings.TriggerDelay)
    canShoot = true
end

-- ===== КЛАВИШИ =====
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = false
        lastTarget = nil
    end
end)

-- ===== ОСНОВНОЙ ЦИКЛ =====
RunService.RenderStepped:Connect(function()
    for _, drawing in pairs(Drawings) do
        pcall(function() drawing:Remove() end)
    end
    Drawings = {}
    
    -- FOV
    local fovCircle = Drawing.new("Circle")
    fovCircle.Visible = true
    fovCircle.Radius = Settings.AimbotFOV
    fovCircle.Thickness = 1
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Filled = false
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, fovCircle)
    
    -- ESP (через стены)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            
            if Settings.ESP_Box then
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
        end
    end
    
    -- TRIGGERBOT
    if Settings.TriggerBot and canShoot then
        local target = GetClosestPlayer()
        if target and IsAimingAtHead(target) then
            Shoot()
        end
    end
    
    -- ===== ИДЕАЛЬНЫЙ AIMBOT (БЕЗ ОТСТАВАНИЯ) =====
    if Settings.Aimbot and isAimbotKeyPressed then
        local target = GetClosestPlayer()
        if target then
            local headPos = GetHeadPosition(target.Character)
            if headPos then
                local screenPos = Camera:WorldToViewportPoint(headPos)
                local mousePos = UserInputService:GetMouseLocation()
                
                local deltaX = screenPos.X - mousePos.X
                local deltaY = screenPos.Y - mousePos.Y
                
                -- БЕЗ ОТСТАВАНИЯ - корректировка каждые 0.5 пикселя
                if math.abs(deltaX) > 0.5 or math.abs(deltaY) > 0.5 then
                    pcall(function()
                        -- Очень быстрое наведение с минимальным сглаживанием
                        mousemoverel(deltaX / Settings.AimbotSmooth, deltaY / Settings.AimbotSmooth)
                    end)
                end
            end
        end
    end
end)

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Sniper Arena",
        Text = "E - PERFECT AIM (no lag) | WallCheck ON",
        Duration = 3
    })
end)

