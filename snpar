local Settings = {
    TriggerBot = false,
    TriggerPrecision = 15, -- Дефолтная точность (радиус в пикселях)
    Mode = "Комбинированный" -- Режим по умолчанию
}

local canShoot = true

-- Заглушки для функций выстрела и поиска целей (замените на свои, если есть в основном скрипте)
local function InstantShoot()
    print("[TriggerBot]: Выстрел!")
    -- Сюда идет ваш код клика/выстрела, например: mouse1click()
end

local function GetTriggerTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < shortestDistance and dist < 150 then -- Радиус обзора триггера
                        shortestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function GetClosestPlayer()
    return GetTriggerTarget()
end

-- ==========================================
-- Исправленная логика Триггербота
-- ==========================================

local function GetHeadWorldPosition(target)
    if not target or not target.Character then return nil end
    local head = target.Character:FindFirstChild("Head")
    return head and head.Position or nil
end

local function IsHeadVisible(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    local origin = Camera.CFrame.Position
    local direction = head.Position - origin
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, target.Character}
    
    local raycastResult = Workspace:Raycast(origin, direction, raycastParams)
    
    if not raycastResult then return true end
    return raycastResult.Instance:IsDescendantOf(target.Character)
end

local function IsPerfectAimingAtHead(target)
    if not target or not target.Character then return false end
    local headPos = GetHeadWorldPosition(target)
    if not headPos then return false end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
    
    local distance = (Camera.CFrame.Position - headPos).Magnitude
    local precision = Settings.TriggerPrecision
    
    if distance > 200 then
        precision = precision * 0.6
    elseif distance > 100 then
        precision = precision * 0.8
    end
    
    if dist > precision then return false end
    
    local humanoid = target.Character:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0
end

local function PerfectTriggerBot()
    if not Settings.TriggerBot or not canShoot then return end
    local target = GetTriggerTarget()
    if not target or not IsHeadVisible(target) or not IsPerfectAimingAtHead(target) then return end
    
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    for _, child in pairs(tool:GetDescendants()) do
        if child:IsA("NumberValue") and child.Name:lower():find("cooldown") and child.Value > 0 then
            return
        end
    end
    
    InstantShoot()
end

local function SmartTriggerBot()
    if not Settings.TriggerBot or not canShoot then return end
    local target = GetClosestPlayer()
    if not target or not IsHeadVisible(target) then return end
    
    local headPos = GetHeadWorldPosition(target)
    if not headPos then return end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    if not onScreen then return end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
    
    if dist < 50 then
        local deltaX = screenPos.X - mousePos.X
        local deltaY = screenPos.Y - mousePos.Y
        
        if mousemoverel then
            pcall(function() mousemoverel(deltaX * 0.3, deltaY * 0.3) end)
        end
        
        local newMousePos = UserInputService:GetMouseLocation()
        local newDist = (Vector2.new(screenPos.X, screenPos.Y) - newMousePos).Magnitude
        
        if newDist < Settings.TriggerPrecision then
            local humanoid = target.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                InstantShoot()
            end
        end
    end
end

local function UltraPreciseTriggerBot()
    if not Settings.TriggerBot or not canShoot then return end
    local target = GetTriggerTarget()
    if not target then return end
    
    local humanoid = target.Character and target.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 or not IsHeadVisible(target) then return end
    
    local headPos = GetHeadWorldPosition(target)
    if not headPos then return end
    
    local camPos = Camera.CFrame.Position
    local directionToHead = (headPos - camPos).Unit
    local camDirection = Camera.CFrame.LookVector
    
    local angle = math.acos(math.clamp(camDirection:Dot(directionToHead), -1, 1))
    if math.deg(angle) > 0.5 then return end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    if not onScreen then return end
    
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local pixelDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
    
    if pixelDist <= 30 then
        InstantShoot()
    end
end

-- Основной цикл работы скрипта
task.spawn(function()
    while task.wait() do
        if Settings.TriggerBot then
            if Settings.Mode == "Идеальный" then
                PerfectTriggerBot()
            elseif Settings.Mode == "Умный" then
                SmartTriggerBot()
            elseif Settings.Mode == "Точный" then
                UltraPreciseTriggerBot()
            elseif Settings.Mode == "Комбинированный" then
                UltraPreciseTriggerBot()
                if canShoot then
                    SmartTriggerBot()
                end
            end
        end
    end
end)


