Players.PlayerAdded:Connect(function() task.wait(1); CheckAdmins() end)

-- ===== КЛАВИШИ УПРАВЛЕНИЯ =====
UserInputService.InputBegan:Connect(function(i)
    if i.KeyCode == Settings.AimbotKey then isAimbotKeyPressed = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.KeyCode == Settings.AimbotKey then isAimbotKeyPressed = false; currentTarget = nil end
end)

-- ===== ОСНОВНОЙ ТАКТ (RENDERSTEPPED) =====
RunService.RenderStepped:Connect(function()
    for _, d in pairs(Drawings) do pcall(d.Remove, d) end
    Drawings = {}
    
    if Settings.Aimbot then
        DrawFOV()
    end
    
    -- Обработка ESP и Хитбоксов
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            local vis = IsPlayerVisible(char)
            
            if Settings.ESP_TeamCheck and player.Team == LocalPlayer.Team then 
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
                continue 
            end
            
            if not Settings.ESP_Visible and not vis then
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
                continue
            end
            
            if Settings.ESP_Box then
                local h = char:FindFirstChild("PoloESP")
                if not h then
                    h = Instance.new("Highlight")
                    h.Name = "PoloESP"
                    h.Parent = char
                end
                h.FillColor = vis and Color3.fromRGB(140, 60, 255) or Color3.fromRGB(255, 60, 100)
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.FillTransparency = 0.4
                h.DepthMode = Settings.ESP_Visible and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
            
            if Settings.ESP_Skeleton then DrawSkeleton(char) end
            if Settings.ESP_Distance then DrawDistance(char) end
            if Settings.ESP_Line then DrawLineToPlayer(char) end
        end
    end
    
    -- Логика Аимбота
    if Settings.Aimbot and isAimbotKeyPressed then
        local target = GetClosestPlayer()
        if target then InstantAim(target) end
    end
    
    -- Модификации оружия
    ApplyWeaponMods()
    
    -- Моментальный Триггер
    if Settings.TriggerBot and canShoot then
        local tTarget = GetTriggerTarget()
        if tTarget and IsPerfectAimingAtHead(tTarget) then
            PerfectShot()
        end
    end
end)
