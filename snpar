local currentActiveButton = nil
local function SwitchTab(tabName, button)
    for name, page in pairs(Pages) do page.Visible = (name == tabName) end
    if currentActiveButton then 
        TweenService:Create(currentActiveButton, TweenInfo.new(0.25), {
            BackgroundColor3 = Color3.fromRGB(16, 16, 22),
            TextColor3 = Color3.fromRGB(150, 150, 155)
        }):Play()
        currentActiveButton:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(30, 30, 35)
    end
    currentActiveButton = button
    TweenService:Create(button, TweenInfo.new(0.25), {
        BackgroundColor3 = Color3.fromRGB(22, 35, 35),
        TextColor3 = Color3.fromRGB(0, 255, 204)
    }):Play()
    button:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(0, 255, 204)
end

