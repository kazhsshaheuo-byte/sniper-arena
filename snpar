-- ===== ЕДИНЫЙ ВЫСОКОТОЧНЫЙ ПОТОК =====
RunService.RenderStepped:Connect(function()
    if not ScriptActive then return end 
    
    -- FOV ВСЕГДА НА ЭКРАНЕ (зависит только от настроек чита, а не видимости GUI)
    if FOVCircle then
        FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            
            if head and head:IsA("BasePart") then
                if Settings.ExpandHeads and Settings.HeadSize > 1 then
                    head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                    head.Transparency = 0.7 
                    head.CanCollide = false
                    head.Massless = true
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
                
                if Settings.ESP_Box then
                    local highlight = char:FindFirstChild("PoloESP")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "PoloESP"
                        highlight.Parent = char
                    end
                    highlight.FillColor = Color3.fromRGB(255, 255, 255) -- Белая обводка боксов под неон
                    highlight.OutlineColor = Color3.fromRGB(200, 200, 205)
                    highlight.FillTransparency = 0.6
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    local h = char:FindFirstChild("PoloESP")
                    if h then h:Destroy() end
                end
            end
        end
    end
    
    -- ИДЕАЛЬНЫЙ ТРИГГЕРБОТ
    if Settings.TriggerBot and isActivationKeyPressed then
        local mouseRay = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        
        local result = workspace:Raycast(mouseRay.Origin, mouseRay.Direction.Unit * 1000, params)
        
        if result and result.Instance then
            local hitPart = result.Instance
            local hitModel = hitPart.Parent
            
            if hitModel:IsA("Accessory") and hitModel.Parent then
                hitModel = hitModel.Parent
            end
            
            local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
            if hitPlayer and hitPlayer ~= LocalPlayer then
                if IsPlayerVisible(hitModel) then
                    InstantShoot()
                end
            end
        end
    end
    
    -- ИДЕАЛЬНЫЙ АИМБОТ
    if Settings.Aimbot and isActivationKeyPressed then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local exactHeadPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, exactHeadPos)
        end
    end
end)
