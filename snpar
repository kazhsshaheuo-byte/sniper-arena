-- Sniper Arena Script by wizzey
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Настройки
local Settings = {
    Aimbot = true,
    AimbotFOV = 300,
    AimbotKey = Enum.KeyCode.E,
    AimbotSmooth = 1,
    TriggerBot = true,
    TriggerPrecision = 15,
    ESP_Box = true,
}

local isAimbotKeyPressed = false
local Drawings = {}
local canShoot = true
local currentTarget = nil

-- Функции
local function GetHeadPosition(char)
    local head = char:FindFirstChild("Head")
    return head and head.Position or nil
end

local function GetClosestPlayer()
    local closest = nil
    local closestDist = Settings.AimbotFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local headPos = GetHeadPosition(player.Character)
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function IsAimingAtHead(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
    
    return dist < Settings.TriggerPrecision
end

local function Shoot()
    if not canShoot then return end
    canShoot = false
    pcall(function() mouse1click() end)
    task.wait(0.05)
    canShoot = true
end

-- Клавиши
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = false
    end
end)

-- Главный цикл
RunService.RenderStepped:Connect(function()
    -- Очистка старых рисунков
    for _, drawing in pairs(Drawings) do
        pcall(function() drawing:Remove() end)
    end
    Drawings = {}
    
    -- Рисуем FOV
    if Settings.Aimbot then
        local fovCircle = Drawing.new("Circle")
        fovCircle.Visible = true
        fovCircle.Radius = Settings.AimbotFOV
        fovCircle.Thickness = 1
        fovCircle.Color = Color3.fromRGB(255, 255, 255)
        fovCircle.Filled = false
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        table.insert(Drawings, fovCircle)
    end
    
    -- ESP
    if Settings.ESP_Box then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                local char = player.Character
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
        end
    end
    
    -- TriggerBot
    if Settings.TriggerBot and canShoot then
        local target = GetClosestPlayer()
        if target and IsAimingAtHead(target) then
            Shoot()
        end
    end
    
    -- Aimbot
    if Settings.Aimbot and isAimbotKeyPressed then
        local target = GetClosestPlayer()
        if target then
            local headPos = GetHeadPosition(target.Character)
            if headPos then
                local screenPos = Camera:WorldToViewportPoint(headPos)
                local mousePos = UserInputService:GetMouseLocation()
                
                local deltaX = screenPos.X - mousePos.X
                local deltaY = screenPos.Y - mousePos.Y
                
                if math.abs(deltaX) > 2 or math.abs(deltaY) > 2 then
                    pcall(function()
                        if Settings.AimbotSmooth <= 1 then
                            mousemoverel(deltaX, deltaY)
                        else
                            mousemoverel(deltaX / Settings.AimbotSmooth, deltaY / Settings.AimbotSmooth)
                        end
                    end)
                end
            end
        end
    end
end)

-- Уведомление
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Sniper Arena",
        Text = "Hold E for aimbot",
        Duration = 3
    })
end)

