-- Polo Sniper Arena - ULTRA AIMBOT (Для Sniper Arena, без отставания + WallCheck)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local Settings = {
    Aimbot = true,
    AimbotFOV = 300,
    AimbotKey = Enum.KeyCode.E,
    AimbotWallCheck = true, -- ВКЛЮЧЕНА ПРОВЕРКА СТЕН ДЛЯ АИМБОТА
    
    TriggerBot = true,
    TriggerDelay = 0.03,
    TriggerPrecision = 10,
    
    ESP_Box = true,
    ESP_Visible = true,
    WallCheck = true,
    
    NoRecoil = true,
    NoSpread = true,
    FastReload = true,
}

local isAimbotKeyPressed = false
local Drawings = {}
local canShoot = true
local currentTarget = nil

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = false
        currentTarget = nil
    end
end)

local function GetHeadPosition(character)
    local head = character:FindFirstChild("Head")
    if head then
        return head.Position
    end
    return nil
end

-- ===== ПРОВЕРКА ВИДИМОСТИ (WALL CHECK) =====
local function IsPlayerVisible(character)
    if not character or not character:FindFirstChild("Head") then
        return false
    end
    
    local head = character.Head
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
    
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    
    if not raycastResult then
        return true
    end
    
    local hitPart = raycastResult.Instance
    if hitPart and hitPart:IsDescendantOf(character) then
        return true
    end
    
    return false
end

local function IsAimingAtHead(target)
    if not target or not target.Character then return false end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    local headPos = head.Position
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
    
    if dist > Settings.TriggerPrecision then
        return false
    end
    
    local humanoid = target.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end
    
    return true
end

local function GetTriggerTarget()
    local bestTarget = nil
    local bestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local character = player.Character
            
            if not IsPlayerVisible(character) then
                continue
            end
            
            local headPos = GetHeadPosition(character)
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < bestDist and dist < Settings.AimbotFOV then
                        bestDist = dist
                        bestTarget = player
                    end
                end
            end
        end
    end
    
    return bestTarget
end

-- ===== ПОЛУЧЕНИЕ БЛИЖАЙШЕГО ИГРОКА (С WALL CHECK ДЛЯ АИМА) =====
local function GetClosestPlayer()
    local closest = nil
    local closestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Сначала проверяем текущую цель
    if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Head") then
        local headPos = GetHeadPosition(currentTarget.Character)
        if headPos then
            local pos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen and pos.Z > 0 then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < Settings.AimbotFOV then
                    -- Проверяем видимость цели
                    if Settings.AimbotWallCheck then
                        if IsPlayerVisible(currentTarget.Character) then
                            return currentTarget
                        else
                            -- Если цель за стеной, ищем другую
                            currentTarget = nil
                        end
                    else
                        return currentTarget
                    end
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local character = player.Character
            
            -- ===== WALL CHECK ДЛЯ АИМБОТА =====
            if Settings.AimbotWallCheck then
                -- ПРОПУСКАЕМ ИГРОКОВ ЗА СТЕНАМИ
                if not IsPlayerVisible(character) then
                    continue
                end
            end
            
            local headPos = GetHeadPosition(character)
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist and dist < Settings.AimbotFOV then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    if closest then
        currentTarget = closest
    end
    
    return closest
end

-- ===== АИМ ДЛЯ SNIPER ARENA (С WALL CHECK) =====
local function AimAtHeadSniper(target)
    if not target or not target.Character then return end
    
    local character = target.Character
    
    -- Дополнительная проверка видимости перед наведением
    if Settings.AimbotWallCheck then
        if not IsPlayerVisible(character) then
            return
        end
    end
    
    local headPos = GetHeadPosition(character)
    if not headPos then return end
    
    local camPos = Camera.CFrame.Position
    local direction = (headPos - camPos).Unit
    local newCF = CFrame.lookAt(camPos, headPos)
    
    -- Плавно поворачиваем камеру
    Camera.CFrame = Camera.CFrame:Lerp(newCF, 0.5)
    
    -- Движение мыши (для точности)
    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
    if onScreen then
        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPos.X - mousePos.X
        local deltaY = screenPos.Y - mousePos.Y
        
        if math.abs(deltaX) > 1 or math.abs(deltaY) > 1 then
            pcall(function()
                mousemoverel(deltaX, deltaY)
            end)
        end
    end
end

local function Shoot()
    if not canShoot then return end
    canShoot = false
    
    pcall(function()
        mouse1click()
    end)
    
    task.wait(Settings.TriggerDelay)
    canShoot = true
end

local function ApplyWeaponMods()
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    local name = child.Name:lower()
                    
                    if Settings.NoRecoil and (name:find("recoil") or name:find("kick")) then
                        child.Value = 0
                    end
                    
                    if Settings.NoSpread and (name:find("spread") or name:find("accuracy")) then
                        child.Value = 0
                    end
                    
                    if Settings.FastReload and name:find("reload") then
                        child.Value = 0.01
                    end
                end
            end
        end
    end)
end

local function DrawFOV()
    local fovCircle = Drawing.new("Circle")
    fovCircle.Visible = true
    fovCircle.Radius = Settings.AimbotFOV
    fovCircle.Thickness = 2
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Filled = false
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, fovCircle)
    
    local dot = Drawing.new("Circle")
    dot.Visible = true
    dot.Radius = 2
    dot.Color = Color3.fromRGB(255, 0, 0)
    dot.Filled = true
    dot.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, dot)
end

RunService.RenderStepped:Connect(function()
    for _, drawing in pairs(Drawings) do
        pcall(function() drawing:Remove() end)
    end
    Drawings = {}
    
    DrawFOV()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local character = player.Character
            local isVisible = IsPlayerVisible(character)
            
            if not Settings.ESP_Visible and not isVisible then
                local highlight = character:FindFirstChild("PoloESP")
                if highlight then highlight:Destroy() end
                continue
            end
            
            if Settings.ESP_Box then
                local highlight = character:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight", character)
                    highlight.Name = "PoloESP"
                    highlight.FillColor = isVisible and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 255, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.3
                    if Settings.ESP_Visible then
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                end
            end
        end
    end
    
    if Settings.TriggerBot and canShoot then
        local target = GetTriggerTarget()
        if target then
            if IsAimingAtHead(target) then
                local humanoid = target.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    Shoot()
                end
            end
        end
    end
    
    if Settings.Aimbot and isAimbotKeyPressed then
        local target = GetClosestPlayer()
        if target then
            AimAtHeadSniper(target)
        end
    end
    
    if Settings.NoRecoil or Settings.NoSpread or Settings.FastReload then
        ApplyWeaponMods()
    end
end)

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Polo Sniper Arena",
        Text = "Aimbot (E) | WallCheck ON",
        Duration = 3
    })
end)

