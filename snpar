local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ===== НАСТРОЙКИ =====
local Settings = {
    Aimbot = true,
    AimbotFOV = 300,
    AimbotKey = Enum.KeyCode.E,
    TriggerBot = true,
    TriggerPrecision = 8, -- МАКСИМАЛЬНАЯ ТОЧНОСТЬ
    ESP_Box = true,
}

-- ===== ПЕРЕМЕННЫЕ =====
local isKeyPressed = false
local Drawings = {}
local canShoot = true
local currentTarget = nil
local lastTarget = nil

-- ===== WALL CHECK =====
local function IsPlayerVisible(char)
    if not char or not char:FindFirstChild("Head") then return false end
    local head = char.Head
    local origin = Camera.CFrame.Position
    local dir = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(char)
end

local function GetHeadPosition(char)
    local head = char:FindFirstChild("Head")
    return head and head.Position or nil
end

-- ===== AIMBOT =====
local function GetClosestPlayer()
    local closest = nil
    local closestDist = Settings.AimbotFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    if lastTarget and lastTarget.Character and lastTarget.Character:FindFirstChild("Head") then
        local headPos = GetHeadPosition(lastTarget.Character)
        if headPos then
            local pos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen and pos.Z > 0 then
                local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if dist < Settings.AimbotFOV then
                    return lastTarget
                end
            end
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            local headPos = GetHeadPosition(char)
            
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    if closest then
        lastTarget = closest
    end
    
    return closest
end

-- ===== ИДЕАЛЬНЫЙ ТРИГГЕР (СТРЕЛЯЕТ ТОЛЬКО ПРИ 100% ПОПАДАНИИ) =====
local function IsPerfectAim(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    -- Проверка видимости
    if not IsPlayerVisible(target.Character) then
        return false
    end
    
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
    
    -- СТРОГАЯ ПРОВЕРКА - только при точном попадании
    if dist > Settings.TriggerPrecision then
        return false
    end
    
    -- Проверка что голова в центре экрана
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local centerDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
    
    -- Голова должна быть в центре экрана (не более 50 пикселей от центра)
    if centerDist > 50 then
        return false
    end
    
    -- Проверка угла между прицелом и головой
    local camPos = Camera.CFrame.Position
    local camDir = Camera.CFrame.LookVector
    local dirToHead = (head.Position - camPos).Unit
    local angle = math.deg(math.acos(math.clamp(camDir:Dot(dirToHead), -1, 1)))
    
    -- Угол должен быть минимальным (почти идеальное наведение)
    if angle > 0.5 then
        return false
    end
    
    return true
end

local function Shoot()
    if not canShoot then return end
    canShoot = false
    
    task.spawn(function()
        pcall(function()
            mouse1click()
        end)
        task.wait(0.01)
        canShoot = true
    end)
end

-- ===== КЛАВИШИ =====
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isKeyPressed = false
        lastTarget = nil
    end
end)

