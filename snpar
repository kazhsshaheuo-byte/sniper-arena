-- Sniper Arena Script by wizzey (FINAL FIX)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ===== НАСТРОЙКИ =====
local Settings = {
    -- AIMBOT
    Aimbot = true,
    AimbotFOV = 300,
    AimbotKey = Enum.KeyCode.E,
    AimbotSmooth = 1,
    
    -- TRIGGER
    TriggerBot = true,
    TriggerPrecision = 15,
    TriggerDelay = 0.05,
    
    -- ESP
    ESP_Box = true,
}

-- ===== ПЕРЕМЕННЫЕ =====
local isAimbotKeyPressed = false
local Drawings = {}
local canShoot = true
local currentTarget = nil

-- ===== WALL CHECK (ДЛЯ ТРИГГЕРА) =====
local function IsPlayerVisible(char)
    if not char or not char:FindFirstChild("Head") then return false end
    local head = char.Head
    local origin = Camera.CFrame.Position
    local dir = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(char)
end

-- ===== ПОЛУЧЕНИЕ ПОЗИЦИИ ГОЛОВЫ =====
local function GetHeadPosition(char)
    local head = char:FindFirstChild("Head")
    return head and head.Position or nil
end

-- ===== AIMBOT (БЕЗ WALLCHECK - ВИДИТ ЧЕРЕЗ СТЕНЫ) =====
local function GetClosestPlayer()
    local closest = nil
    local closestDist = Settings.AimbotFOV
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            local headPos = GetHeadPosition(char)
            
            if headPos then
                local pos, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

-- ===== TRIGGERBOT (СТРЕЛЯЕТ ТОЛЬКО ПО ВИДИМЫМ) =====
local function IsAimingAtHead(target)
    if not target or not target.Character then return false end
    local head = target.Character:FindFirstChild("Head")
    if not head then return false end
    
    -- WALL CHECK ДЛЯ ТРИГГЕРА - СТРЕЛЯЕТ ТОЛЬКО ПО ВИДИМЫМ
    if not IsPlayerVisible(target.Character) then
        return false
    end
    
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
    
    return dist < Settings.TriggerPrecision
end

local function Shoot()
    if not canShoot then return end
    canShoot = false
    pcall(function() mouse1click() end)
    task.wait(Settings.TriggerDelay)
    canShoot = true
end

-- ===== КЛАВИШИ =====
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimbotKey then
        isAimbotKeyPressed = false
        currentTarget = nil
    end
end)

-- ===== ОСНОВНОЙ ЦИКЛ =====
RunService.RenderStepped:Connect(function()
    -- Очистка старых рисунков
    for _, drawing in pairs(Drawings) do
        pcall(function() drawing:Remove() end)
    end
    Drawings = {}
    
    -- FOV круг (300)
    local fovCircle = Drawing.new("Circle")
    fovCircle.Visible = true
    fovCircle.Radius = Settings.AimbotFOV
    fovCircle.Thickness = 1
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
    fovCircle.Filled = false
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.insert(Drawings, fovCircle)
    
    -- ===== ESP (ВСЕГДА ЧЕРЕЗ СТЕНЫ) =====
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local char = player.Character
            
            if Settings.ESP_Box then
                local highlight = char:FindFirstChild("PoloESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "PoloESP"
                    highlight.Parent = char
                end
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            else
                local h = char:FindFirstChild("PoloESP")
                if h then h:Destroy() end
            end
        end
    end
    
    -- ===== TRIGGERBOT (ТОЛЬКО ПО ВИДИМЫМ) =====
    if Settings.TriggerBot and canShoot then
        local target = GetClosestPlayer()
        if target and IsAimingAtHead(target) then
            Shoot()
        end
    end
    
    -- ===== AIMBOT (ВИДИТ ЧЕРЕЗ СТЕНЫ) =====
    if Settings.Aimbot and isAimbotKeyPressed then
        local target = GetClosestPlayer()
        if target then
            local headPos = GetHeadPosition(target.Character)
            if headPos then
                local screenPos = Camera:WorldToViewportPoint(headPos)
                local mousePos = UserInputService:GetMouseLocation()
                
                local deltaX = screenPos.X - mousePos.X
                local deltaY = screenPos.Y - mousePos.Y
                
                if math.abs(deltaX) > 2 or math.abs(deltaY) > 2 then
                    pcall(function()
                        if Settings.AimbotSmooth <= 1 then
                            mousemoverel(deltaX, deltaY)
                        else
                            mousemoverel(deltaX / Settings.AimbotSmooth, deltaY / Settings.AimbotSmooth)
                        end
                    end)
                end
            end
        end
    end
end)

