-- ===== ИДЕАЛЬНЫЙ СИНХРОННЫЙ ЦИКЛ ОБРАБОТКИ =====
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = Settings.ShowFOV and Settings.Aimbot
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            
            if head and head:IsA("BasePart") then
                -- Постоянное принудительное расширение хитбокса
                if Settings.HeadSize > 1 then
                    head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                    head.Transparency = 0.7 
                    head.CanCollide = false
                    head.Massless = true
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
                
                -- Рендер ESP
                if Settings.ESP_Box then
                    local highlight = char:FindFirstChild("PoloESP")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "PoloESP"
                        highlight.Parent = char
                    end
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.4
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    local h = char:FindFirstChild("PoloESP")
                    if h then h:Destroy() end
                end
            end
        end
    end
    
    -- ЛОГИКА АИМА И ВЫСОКОТОЧНОГО ТРИГГЕРА
    if Settings.TriggerBot then
        -- Высокоточный Raycast-прострел из центра экрана строго по РЕАЛЬНОМУ хитбоксу
        local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if result and result.Instance then
            local hitPart = result.Instance
            local model = hitPart:FindFirstAncestorOfClass("Model")
            
            if model and Players:GetPlayerFromCharacter(model) and Players:GetPlayerFromCharacter(model) ~= LocalPlayer then
                -- Если луч попал в голову (или расширенную голову, но мы проверяем дистанцию до реального центра шеи)
                if hitPart.Name == "Head" then
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- Проверяем, находится ли луч в пределах оригинального радиуса головы (1.2-1.5 студа) от центра шеи
                        local realHeadCenter = hrp.Position + Vector3.new(0, 1.6, 0)
                        local distanceToTrueHead = (result.Position - realHeadCenter).Magnitude
                        
                        if distanceToTrueHead <= 1.5 then -- Срабатывает только на реальный размер головы!
                            InstantShoot()
                        end
                    end
                end
            end
        end
    end
    
    if isKeyPressed and Settings.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            -- Математически чистая позиция реальной головы
            local exactHeadPos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 1.6, 0)
            
            -- Мертвая фиксация камеры БЕЗ конфликтующих смещений мыши
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, exactHeadPos)
        end
    end
end)
